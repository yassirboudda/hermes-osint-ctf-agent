# === Hermes OSINT CTF Agent — PUBLIC TEMPLATE ===
# Copy to .env and replace **** with YOUR values.
# NEVER commit a filled .env

# --- Models / LLM providers ---
# Choose independently for orchestrator vs sub-agents:
#   deepseek | openrouter | nousresearch
ORCHESTRATOR_PROVIDER=deepseek
SUBAGENT_PROVIDER=openrouter
# Optional global fallback (used if ORCHESTRATOR_PROVIDER unset):
# LLM_PROVIDER=deepseek
# Optional model overrides:
# ORCHESTRATOR_MODEL=****
# SUBAGENT_MODEL=****

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=****
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter — https://openrouter.ai/
OPENROUTER_API_KEY=****
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sub-agents: orchestrator may pick any OpenRouter model
OPENROUTER_DEFAULT_MODEL=****

# Nous Research (Hermes) — create key at https://portal.nousresearch.com
# API docs: https://portal.nousresearch.com/api-docs
# OpenAI-compatible inference: https://inference-api.nousresearch.com/v1
NOUS_API_KEY=****
# Aliases also accepted: NOUSRESEARCH_API_KEY / NOUS_PORTAL_API_KEY
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
# Hermes-4.3-36B | Hermes-4-70B | Hermes-4-405B
NOUS_MODEL=Hermes-4.3-36B
# Example: run everything on Nous Hermes
# ORCHESTRATOR_PROVIDER=nousresearch
# SUBAGENT_PROVIDER=nousresearch
# ORCHESTRATOR_MODEL=Hermes-4-70B
# SUBAGENT_MODEL=Hermes-4-405B

# --- OPSEC: dedicated CTF User-Agent (NOT your desktop Chrome UA) ---
CTF_UA=Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0

# --- OSINT Industries (API key — NOT browser cookies) ---
# Docs: https://api.osint.industries/misc/docs
# Used when set; if missing/****, username pivots rely on InstantUsername + Rosint only.
OSINT_INDUSTRIES_API_KEY=****
OSINT_INDUSTRIES_BASE_URL=https://api.osint.industries
OSINT_INDUSTRIES_MAX_LOOKUPS=5

# --- Rosint-style Reddit archives (no key; Arctic Shift + PullPush) ---
# UI twin: https://www.rosint.dev/?u=<username>
ROSINT_ARCTIC_BASE=https://arctic-shift.photon-reddit.com
ROSINT_PULLPUSH_BASE=https://api.pullpush.io
ROSINT_LIMIT=100
ROSINT_TIMEOUT=45

# --- Instant Username–style multi-site search ---
# UI twin: https://instantusername.com/?q=<username>
# Automation uses WhatsMyName data (IUS has no public self-serve API).
# Optional: self-hosted / proxied Instant Username check API
# INSTANTUSERNAME_API_BASE=https://****.example
INSTANTUSERNAME_MAX_SITES=80
INSTANTUSERNAME_WORKERS=12
INSTANTUSERNAME_TIMEOUT=12
# WHATSMyNAME_DATA_URL=https://raw.githubusercontent.com/WebBreacher/WhatsMyName/main/wmn-data.json
# WHATSMyNAME_CACHE=cache/wmn-data.json

# --- Maigret (https://github.com/soxoj/maigret) ---
# Subset path ships in-repo; full engine: pip install -r requirements-maigret.txt
# MAIGRET_SUBSET_PATH=data/maigret_subset.json
MAIGRET_TOP=100
MAIGRET_MAX_TOP=250
MAIGRET_TIMEOUT=12
MAIGRET_WORKERS=16
MAIGRET_EXCLUDE_TAGS=nsfw,dating

# --- Mailbox (dedicated CTF inbox) ---
CTF_MAIL_ADDRESS=****@****
CTF_MAIL_IMAP_HOST=****
CTF_MAIL_IMAP_USER=****
CTF_MAIL_IMAP_PASSWORD=****
# If Gmail OAuth:
GMAIL_CLIENT_ID=****
GMAIL_CLIENT_SECRET=****
GMAIL_REFRESH_TOKEN=****

# --- Captcha solvers ---
CAPSOLVER_API_KEY=****
TWOCAPTCHA_API_KEY=****
ANTICAPTCHA_API_KEY=****

# --- Browser automation ---
BROWSER_USE_API_KEY=****
BROWSER_USE_BASE_URL=****
APIFY_TOKEN=****
APIFY_USER_ID=****

# --- Passive OSINT APIs ---
SHODAN_API_KEY=****
SECURITYTRAILS_API_KEY=****
GITHUB_TOKEN=****
WIGLE_API_NAME=****
WIGLE_API_TOKEN=****

# --- OSINTMapper (agent can list/create/update entities) ---
OSINTMAPPER_BASE_URL=https://****.example/mapper
OSINTMAPPER_USERNAME=****
OSINTMAPPER_PASSWORD=****
# Or bearer after login:
OSINTMAPPER_TOKEN=****

# --- CTFd (session after YOUR registration — cookies redacted in public repo) ---
CTFD_BASE_URL=https://****.example
CTFD_SESSION=****
CTFD_NONCE=****
# Optional: path to local session JSON (gitignored)
# CTFD_SESSION_FILE=secrets/ctfd_session.json

# --- Optional STT / vision helpers ---
OPENAI_API_KEY=****
GROQ_API_KEY=****
